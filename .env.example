# TRACE -- environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
#
# On Streamlit Community Cloud, set these in the app's Secrets manager
# (Settings -> Secrets) instead of using a .env file.

# Which LLM provider to use. Supported: gemini
LLM_PROVIDER=gemini

# API key for the provider above. Placeholder only -- put your real key in .env
LLM_API_KEY=your-api-key-here

# Model identifier
# Google retires models over time. If you get a "not available" error,
# list what your key can use and pick a current one.
LLM_MODEL=gemini-3.6-flash

# Optional: override the provider base URL. Leave unset unless you need it.
# LLM_BASE_URL=

# Optional: path to the SQLite database file (default: data/trace.db)
# TRACE_DB_PATH=data/trace.db

# Optional: maximum upload size per file in megabytes (default: 10)
# TRACE_MAX_UPLOAD_MB=10
